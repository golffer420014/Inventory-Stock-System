<!-- Handlebars template สำหรับ render เป็น PDF ผ่าน Puppeteer (invoice.controller.ts) -->
<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="utf-8" />
  <title>Invoice {{invoiceNumber}}</title>
  <style>
    body { font-family: 'Tahoma', 'Segoe UI', sans-serif; padding: 24px; color: #222; }
    .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
    h1 { font-size: 22px; margin: 0 0 4px; }
    .meta { color: #666; font-size: 12px; }
    .doc-info { text-align: right; font-size: 12px; color: #444; }
    .doc-info .invoice-number { font-size: 16px; font-weight: 700; color: #222; }
    table { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 16px; }
    th, td { border: 1px solid #ddd; padding: 6px 8px; text-align: left; }
    th { background: #f3f3f3; }
    .text-right { text-align: right; }
    .total-row td { border: none; padding-top: 10px; font-size: 15px; font-weight: 700; }
  </style>
</head>
<body>
  <div class="header">
    <div>
      <h1>ใบแจ้งหนี้ (Invoice)</h1>
      <div class="meta">อ้างอิงคำสั่งขาย {{orderNumber}} · สร้างเมื่อ {{formatDate generatedAt}}</div>
    </div>
    <div class="doc-info">
      <div class="invoice-number">{{invoiceNumber}}</div>
      <div>วันที่ออกเอกสาร {{formatDate createdAt}}</div>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>SKU</th>
        <th>สินค้า</th>
        <th class="text-right">จำนวน</th>
        <th class="text-right">ราคาต่อหน่วย</th>
        <th class="text-right">รวม</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr>
        <td>{{this.sku}}</td>
        <td>{{this.name}}</td>
        <td class="text-right">{{this.quantity}}</td>
        <td class="text-right">{{formatCurrency this.unitPrice}}</td>
        <td class="text-right">{{formatCurrency this.subtotal}}</td>
      </tr>
      {{/each}}
    </tbody>
    <tfoot>
      <tr class="total-row">
        <td colspan="4" class="text-right">ยอดรวมทั้งสิ้น</td>
        <td class="text-right">{{formatCurrency totalAmount}} บาท</td>
      </tr>
    </tfoot>
  </table>
</body>
</html>
