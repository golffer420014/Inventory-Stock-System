PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Supabase Dashboard > Project Settings > Database > Connection pooling (Session mode)
# Direct connection (db.<ref>.supabase.co) เป็น IPv6-only แล้ว ใช้ pooler แทนถ้าเน็ตไม่รองรับ IPv6
DATABASE_URL=postgresql://postgres.slbxcfteatdzglsqgdbe:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

REDIS_URL=redis://localhost:6379

# Supabase Dashboard > Settings > API
# SUPABASE_SECRET_KEY (service role) ใช้ทั้ง bypass RLS และอัปโหลดไฟล์เข้า Storage bucket "uploads" (ต้องสร้าง bucket นี้ไว้ล่วงหน้า เป็น public)
SUPABASE_URL=https://slbxcfteatdzglsqgdbe.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://slbxcfteatdzglsqgdbe.supabase.co/auth/v1/.well-known/jwks.json
